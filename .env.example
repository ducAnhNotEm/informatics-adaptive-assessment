# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# --- LLM lõi 1: Ollama local (AGENTS.md §9) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# --- LLM lõi 2: Gemini fallback ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Circuit breaker ---
LLM_TIMEOUT_SECONDS=5.0

# --- Sandbox (AGENTS.md §5) ---
SANDBOX_TIMEOUT_SECONDS=2.0
SANDBOX_MEMORY_MB=128

# --- Database ---
DATABASE_PATH=data/app.db
